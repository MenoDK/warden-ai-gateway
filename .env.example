# Copy to .env and adjust. Every value below is a fictitious placeholder.

APP_ENV=development            # "production" refuses the default API key and never uses the demo model
LOG_LEVEL=INFO

# --- Auth ---------------------------------------------------------------------------------
API_KEY=change-me              # sent by clients as the X-API-Key header

# --- LLM providers (empty URL = provider disabled) ----------------------------------------------
# Local provider: any OpenAI-compatible server inside your trust boundary (e.g. Ollama).
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.2
# External provider: only ever receives pseudonymised, non-sensitive content.
EXTERNAL_LLM_URL=
EXTERNAL_LLM_KEY=
EXTERNAL_LLM_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT_SECONDS=30
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_SECONDS=30

# --- RAG ------------------------------------------------------------------------------------------
EMBEDDING_DIM=256
RAG_MIN_SCORE=0.2              # similarity threshold of the evidence policy
RAG_MIN_EVIDENCE=1             # minimum supporting chunks before the model is called
RAG_TOP_K=4
ALLOWED_SOURCES=docs/*,kb/*,wiki/*
MAX_DOCUMENT_CHARS=200000

# --- Stores (set by docker compose; empty = in-memory) ----------------------------------------------
DATABASE_URL=
REDIS_URL=
DB_PASSWORD=ai                 # compose only: password of the local development database

# --- Webhooks ---------------------------------------------------------------------------------------
# Comma-separated: first = current secret, the rest are still accepted (zero-downtime rotation).
WEBHOOK_SECRETS=whsec_example_current,whsec_example_previous
WEBHOOK_TOLERANCE_SECONDS=300
WEBHOOK_DEDUPE_TTL_SECONDS=86400
